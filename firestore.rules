rules_version = '2';

// =====================================================================
// AGRO FIELDS V8 - FIRESTORE RULES (BORRADOR PARA PROBAR EN EMULADOR)
//
// Principios:
//  1) Todo estÃ¡ prohibido salvo lo que se permite acÃ¡ abajo.
//  2) El expediente privado (activos_agro) solo lo ven su dueÃ±o
//     (propietarioId) y quien lo cargÃ³ (publicadorId).
//  3) El marketplace lee SOLO activos_publicos (resumen publicable),
//     nunca el expediente privado.
//  4) Publicar pasa por revisiÃ³n: el dueÃ±o pide (pendienteRevision) y
//     el administrador aprueba (publicado).
//  5) El campo "rol" del usuario no lo puede cambiar la app.
//  6) AuditorÃ­a y eventos son de solo agregar (no se editan ni borran).
//  7) Cada colecciÃ³n nueva nace con su regla acÃ¡.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // FUNCIONES AUXILIARES
    // -----------------------------------------------------------------

    // UIDs de administradores (v1 mÃ­nimo).
    function adminUids() {
      return ['RtUPcWdZHuQMNsDrza7firR2X2j1'];
    }

    function logueado() {
      return request.auth != null;
    }

    // Administrador: por UID de la lista, o por custom claim "admin".
    function esAdmin() {
      return logueado()
        && (request.auth.uid in adminUids()
            || request.auth.token.get('admin', false) == true);
    }

    function esUsuario(uid) {
      return logueado() && request.auth.uid == uid;
    }

    // true si la escritura modifica alguno de esos campos.
    function cambia(campos) {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(campos);
    }

    function activoDe(id) {
      return get(/databases/$(database)/documents/activos_agro/$(id)).data;
    }

    // DueÃ±o Ãºnico del Activo.
    function esDuenoActivo(id) {
      return logueado() && activoDe(id).propietarioId == request.auth.uid;
    }

    // DueÃ±o o quien cargÃ³ el expediente (ej: inmobiliaria o broker).
    function puedeActivo(id) {
      return logueado()
        && (activoDe(id).propietarioId == request.auth.uid
            || activoDe(id).get('publicadorId', '') == request.auth.uid);
    }

    // Sobre datos ya leÃ­dos (resource.data) de un activo.
    function parteDeActivo(d) {
      return d.propietarioId == request.auth.uid
        || d.get('publicadorId', '') == request.auth.uid;
    }

    // -----------------------------------------------------------------
    // AUTORIZACIONES (paso 3, 06/11/2026)
    // Un tercero (encargado, profesional, etc.) puede actuar sobre un
    // Activo si el dueno le dio una autorizacion ACTIVA y VIGENTE para ese
    // permiso y ese ambito. Como las reglas no pueden buscar, la
    // autorizacion tiene un nombre armado:
    //   activoId__usuario__permiso__ambito
    // (ver AutorizacionActivo.construirId en la app).
    // V1: solo cuentan las autorizaciones para el ambito entero (sin
    // referencia a un lote o modulo puntual).
    // -----------------------------------------------------------------
    function rutaAutorizacion(activoId, permiso, ambito) {
      return /databases/$(database)/documents/autorizaciones_activos/$(activoId + '__' + request.auth.uid + '__' + permiso + '__' + ambito);
    }

    function tieneAutorizacion(activoId, permiso, ambito) {
      return logueado()
        && activoId is string
        && exists(rutaAutorizacion(activoId, permiso, ambito))
        && get(rutaAutorizacion(activoId, permiso, ambito)).data.estado == 'activa'
        && get(rutaAutorizacion(activoId, permiso, ambito)).data.activoId == activoId
        && get(rutaAutorizacion(activoId, permiso, ambito)).data.usuarioAutorizado == request.auth.uid
        && get(rutaAutorizacion(activoId, permiso, ambito)).data.fechaInicio <= request.time
        && (get(rutaAutorizacion(activoId, permiso, ambito)).data.get('fechaFin', null) == null
            || get(rutaAutorizacion(activoId, permiso, ambito)).data.fechaFin > request.time)
        && get(rutaAutorizacion(activoId, permiso, ambito)).data.ambito.get('referenciaId', null) == null;
    }

    // -----------------------------------------------------------------
    // USUARIOS
    // Cada uno ve y edita solo lo suyo. El rol NO lo cambia la app.
    // -----------------------------------------------------------------
    match /usuarios/{uid} {
      allow get: if esUsuario(uid) || esAdmin();
      allow list: if esAdmin();

      // Alta: solo el propio usuario y siempre como 'Comprador'.
      allow create: if esUsuario(uid)
        && request.resource.data.uid == uid
        && request.resource.data.rol == 'Comprador';

      // EdiciÃ³n: el usuario no puede tocar rol, uid ni fechaAlta.
      allow update: if (esUsuario(uid)
          && !cambia(['rol', 'uid', 'fechaAlta']))
        || esAdmin();

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // ACTIVOS_AGRO = EXPEDIENTE PRIVADO
    // El marketplace NO lee esta colecciÃ³n.
    // -----------------------------------------------------------------
    match /activos_agro/{activoId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null || parteDeActivo(resource.data)));

      // Listar: solo lo propio (la app filtra por propietarioId o publicadorId).
      allow list: if esAdmin()
        || (logueado() && parteDeActivo(resource.data));

      // Crear: quien crea debe ser el dueÃ±o o el publicador.
      allow create: if esAdmin()
        || (logueado()
            && (request.resource.data.propietarioId == request.auth.uid
                || request.resource.data.get('publicadorId', '') == request.auth.uid));

      // Editar: dueÃ±o o publicador, sin cambiar quiÃ©n es dueÃ±o ni publicador.
      // (La toma de posesiÃ³n del dueÃ±o se harÃ¡ por un flujo aparte.)
      allow update: if esAdmin()
        || (logueado()
            && parteDeActivo(resource.data)
            && !cambia(['propietarioId', 'publicadorId']));

      // Un expediente no se borra desde la app (trazabilidad).
      allow delete: if esAdmin();
    }

    // -----------------------------------------------------------------
    // ACTIVOS_PUBLICOS = RESUMEN PUBLICABLE (lo que lee el marketplace)
    // El ID del documento es el mismo activoId del expediente.
    // -----------------------------------------------------------------
    match /activos_publicos/{activoId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null
                || (resource.data.estadoPublicacion == 'publicado'
                    && resource.data.visible == true)
                || resource.data.propietarioId == request.auth.uid));

      allow list: if esAdmin()
        || (logueado()
            && ((resource.data.estadoPublicacion == 'publicado'
                 && resource.data.visible == true)
                || resource.data.propietarioId == request.auth.uid));

      // El dueÃ±o solo puede pedir revisiÃ³n (nunca publicar directo).
      allow create: if esAdmin()
        || (esDuenoActivo(activoId)
            && request.resource.data.propietarioId == request.auth.uid
            && request.resource.data.estadoPublicacion == 'pendienteRevision'
            && request.resource.data.visible == false);

      // El dueÃ±o puede editar borrador/pendiente/pausar, pero NO poner 'publicado'.
      allow update: if esAdmin()
        || (esDuenoActivo(activoId)
            && resource.data.propietarioId == request.auth.uid
            && request.resource.data.propietarioId == resource.data.propietarioId
            && request.resource.data.estadoPublicacion
                 in ['borrador', 'pendienteRevision', 'pausado']
            && request.resource.data.visible == false);

      allow delete: if esAdmin();
    }

    // -----------------------------------------------------------------
    // HASHES_ACTIVOS = detecciÃ³n de duplicados sin exponer expedientes
    // El ID del documento es el hash. Solo se puede preguntar por un hash
    // puntual (get); no se puede listar la colecciÃ³n.
    // -----------------------------------------------------------------
    match /hashes_activos/{hash} {
      allow get: if logueado();
      allow list: if false;

      allow create: if logueado()
        && request.resource.data.keys().hasOnly(['creadoPor', 'fecha'])
        && request.resource.data.creadoPor == request.auth.uid;

      allow update, delete: if esAdmin();
    }

    // -----------------------------------------------------------------
    // EVENTOS_AFECTACION (de solo agregar)
    // -----------------------------------------------------------------
    match /eventos_afectacion/{eventoId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null || puedeActivo(resource.data.activoAgroId)));
      allow list: if esAdmin()
        || (logueado() && puedeActivo(resource.data.activoAgroId));

      allow create: if esAdmin()
        || puedeActivo(request.resource.data.activoAgroId);

      allow update: if esAdmin();

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // EVIDENCIAS (se acceden por el Activo al que pertenecen)
    // -----------------------------------------------------------------
    match /evidencias/{evidenciaId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null
                || puedeActivo(resource.data.activoAgroId)
                || tieneAutorizacion(resource.data.activoAgroId, 'ver', 'evidencias')));
      allow list: if esAdmin()
        || (logueado()
            && (puedeActivo(resource.data.activoAgroId)
                || tieneAutorizacion(resource.data.activoAgroId, 'ver', 'evidencias')));

      allow create: if esAdmin()
        || puedeActivo(request.resource.data.activoAgroId)
        || tieneAutorizacion(request.resource.data.activoAgroId, 'crear', 'evidencias');

      allow update: if esAdmin()
        || ((puedeActivo(resource.data.activoAgroId)
             || tieneAutorizacion(resource.data.activoAgroId, 'modificar', 'evidencias'))
            && !cambia(['activoAgroId']));

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // AUDITORIA_ACTIVOS (de solo agregar: no se edita ni se borra)
    // Endurecer mÃ¡s adelante: exigir usuarioId == request.auth.uid.
    // -----------------------------------------------------------------
    match /auditoria_activos/{eventoId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null || puedeActivo(resource.data.activoId)));
      allow list: if esAdmin()
        || (logueado() && puedeActivo(resource.data.activoId));

      // Un autorizado solo agrega registros a su propio nombre, del trabajo
      // que tiene permitido crear. No lee la auditoria (es del dueno).
      allow create: if esAdmin()
        || puedeActivo(request.resource.data.activoId)
        || (request.resource.data.usuarioId == request.auth.uid
            && (tieneAutorizacion(request.resource.data.activoId, 'crear', 'trabajo')
                || tieneAutorizacion(request.resource.data.activoId, 'crear', 'recursosInventario')
                || tieneAutorizacion(request.resource.data.activoId, 'crear', 'evidencias')));

      allow update, delete: if false;
    }
        // -----------------------------------------------------------------
    // RECURSOS = RECURSOS E INVENTARIO V1
    // El recurso pertenece al Activo Agro y hereda su autorización.
    // V1: se consulta y crea; no se modifica ni elimina desde la app.
    // -----------------------------------------------------------------
    match /recursos/{recursoId} {
  allow get: if esAdmin()
    || (logueado()
        && (puedeActivo(resource.data.activoAgroId)
            || tieneAutorizacion(resource.data.activoAgroId, 'ver', 'recursosInventario')));

  allow list: if esAdmin()
    || (logueado()
        && (puedeActivo(resource.data.activoAgroId)
            || tieneAutorizacion(resource.data.activoAgroId, 'ver', 'recursosInventario')));

  allow create: if esAdmin()
    || (logueado()
        && (puedeActivo(request.resource.data.activoAgroId)
            || tieneAutorizacion(request.resource.data.activoAgroId, 'crear', 'recursosInventario')));

  // El saldo solo cambia junto con un movimiento (registrar un movimiento
  // es "crear" en recursos e inventario).
  allow update: if esAdmin()
    || (
      logueado()
      && (puedeActivo(resource.data.activoAgroId)
          || tieneAutorizacion(resource.data.activoAgroId, 'crear', 'recursosInventario'))
      && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'cantidadActual',
            'ultimoMovimientoId',
            'ultimoMovimientoAuditoriaId'
          ])
      && request.resource.data.diff(resource.data).affectedKeys()
          .hasAll([
            'cantidadActual',
            'ultimoMovimientoId',
            'ultimoMovimientoAuditoriaId'
          ])
      && request.resource.data.cantidadActual is number
      && request.resource.data.cantidadActual >= 0
      && request.resource.data.ultimoMovimientoId is string
      && request.resource.data.ultimoMovimientoAuditoriaId is string
      && existsAfter(
        /databases/$(database)/documents/movimientos_stock/$(request.resource.data.ultimoMovimientoId)
      )
      && existsAfter(
        /databases/$(database)/documents/auditoria_activos/$(request.resource.data.ultimoMovimientoAuditoriaId)
      )
      && getAfter(
        /databases/$(database)/documents/movimientos_stock/$(request.resource.data.ultimoMovimientoId)
      ).data.recursoId == recursoId
      && getAfter(
        /databases/$(database)/documents/movimientos_stock/$(request.resource.data.ultimoMovimientoId)
      ).data.activoAgroId == resource.data.activoAgroId
      && getAfter(
        /databases/$(database)/documents/movimientos_stock/$(request.resource.data.ultimoMovimientoId)
      ).data.usuarioId == request.auth.uid
      && getAfter(
        /databases/$(database)/documents/movimientos_stock/$(request.resource.data.ultimoMovimientoId)
      ).data.auditoriaId == request.resource.data.ultimoMovimientoAuditoriaId
      && getAfter(
        /databases/$(database)/documents/movimientos_stock/$(request.resource.data.ultimoMovimientoId)
      ).data.saldoAnterior == resource.data.cantidadActual
      && getAfter(
        /databases/$(database)/documents/movimientos_stock/$(request.resource.data.ultimoMovimientoId)
      ).data.saldoNuevo == request.resource.data.cantidadActual
      && getAfter(
        /databases/$(database)/documents/auditoria_activos/$(request.resource.data.ultimoMovimientoAuditoriaId)
      ).data.usuarioId == request.auth.uid
      && getAfter(
        /databases/$(database)/documents/auditoria_activos/$(request.resource.data.ultimoMovimientoAuditoriaId)
      ).data.activoId == resource.data.activoAgroId
      && getAfter(
        /databases/$(database)/documents/auditoria_activos/$(request.resource.data.ultimoMovimientoAuditoriaId)
      ).data.referencia == request.resource.data.ultimoMovimientoId
      && getAfter(
        /databases/$(database)/documents/auditoria_activos/$(request.resource.data.ultimoMovimientoAuditoriaId)
      ).data.elementoAfectado == recursoId
      && getAfter(
        /databases/$(database)/documents/auditoria_activos/$(request.resource.data.ultimoMovimientoAuditoriaId)
      ).data.accion == 'registrar_movimiento_stock'
    );

  allow delete: if false;
}

    // -----------------------------------------------------------------
    // MOVIMIENTOS_STOCK = movimientos de inventario (solo se agregan)
    // Cada movimiento pertenece a un Activo y hereda su autorizacion.
    // Lo crea movimiento_stock_service dentro de una transaccion, junto con
    // el evento de auditoria y la actualizacion del saldo del recurso
    // (ver la regla de RECURSOS, que exige que este documento exista).
    // Nunca se edita ni se borra: un error se corrige con otro movimiento.
    // -----------------------------------------------------------------
    match /movimientos_stock/{movimientoId} {
      allow get: if esAdmin()
        || (logueado()
            && (puedeActivo(resource.data.activoAgroId)
                || tieneAutorizacion(resource.data.activoAgroId, 'ver', 'recursosInventario')));

      allow list: if esAdmin()
        || (logueado()
            && (puedeActivo(resource.data.activoAgroId)
                || tieneAutorizacion(resource.data.activoAgroId, 'ver', 'recursosInventario')));

      allow create: if esAdmin()
        || (logueado()
            && (puedeActivo(request.resource.data.activoAgroId)
                || tieneAutorizacion(request.resource.data.activoAgroId, 'crear', 'recursosInventario'))
            && request.resource.data.usuarioId == request.auth.uid);

      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // OPORTUNIDADES_AGRO (representacion temporal) - PRIVADA
    // Guarda datos privados (montos, ubicacion exacta, participantes,
    // documentos, evidencias, historial). Por eso solo la leen el admin
    // y quien tiene el Activo (dueno o quien cargo el expediente).
    // Cuando las oportunidades vayan al marketplace, se publicara un
    // resumen aparte, como activos_publicos (paso 2, 06/11/2026).
    // Una oportunidad sin Activo por ahora solo la crea el admin.
    // -----------------------------------------------------------------
    match /oportunidades_agro/{oportunidadId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null
                || (resource.data.get('activoId', null) is string
                    && puedeActivo(resource.data.activoId))));

      allow list: if esAdmin()
        || (logueado()
            && resource.data.get('activoId', null) is string
            && puedeActivo(resource.data.activoId));

      allow create: if esAdmin()
        || esDuenoActivo(request.resource.data.activoId);

      allow update: if esAdmin()
        || (esDuenoActivo(resource.data.activoId)
            && !cambia(['activoId']));

      allow delete: if esAdmin();
    }

    // -----------------------------------------------------------------
    // SOLICITUDES_CONTACTO (entre interesado y propietario)
    // -----------------------------------------------------------------
    match /solicitudes_contacto/{solicitudId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null
                || resource.data.interesadoId == request.auth.uid
                || resource.data.propietarioId == request.auth.uid));
      allow list: if esAdmin()
        || (logueado()
            && (resource.data.interesadoId == request.auth.uid
                || resource.data.propietarioId == request.auth.uid));

      allow create: if logueado()
        && request.resource.data.interesadoId == request.auth.uid
        && request.resource.data.propietarioId != request.auth.uid;

      allow update: if esAdmin()
        || (logueado()
            && (resource.data.interesadoId == request.auth.uid
                || resource.data.propietarioId == request.auth.uid)
            && !cambia(['interesadoId', 'propietarioId', 'campoId']));

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // CHATS y MENSAJES (solo los dos participantes)
    // -----------------------------------------------------------------
    match /chats/{chatId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null
                || resource.data.interesadoId == request.auth.uid
                || resource.data.propietarioId == request.auth.uid));
      allow list: if esAdmin()
        || (logueado()
            && (resource.data.interesadoId == request.auth.uid
                || resource.data.propietarioId == request.auth.uid
                || request.auth.uid in resource.data.participantes));

      allow create: if logueado()
        && (request.resource.data.interesadoId == request.auth.uid
            || request.resource.data.propietarioId == request.auth.uid)
        && request.resource.data.interesadoId
             != request.resource.data.propietarioId
        && request.resource.data.participantes.size() == 2
        && request.resource.data.propietarioId in request.resource.data.participantes
        && request.resource.data.interesadoId in request.resource.data.participantes;

      allow update: if logueado()
        && (resource.data.interesadoId == request.auth.uid
            || resource.data.propietarioId == request.auth.uid)
        && !cambia(['interesadoId', 'propietarioId', 'campoId', 'participantes']);

      allow delete: if false;

      match /mensajes/{mensajeId} {
        function chatDe() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function participaChat() {
          return logueado()
            && (chatDe().interesadoId == request.auth.uid
                || chatDe().propietarioId == request.auth.uid);
        }

        allow read: if participaChat();
        allow create: if participaChat()
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // -----------------------------------------------------------------
    // CAMPOS (modelo VIEJO) - ARCHIVO HISTORICO CONGELADO (paso 5, 06/11/2026)
    // Solo tenia 4 documentos de prueba: no se migran ni se borran
    // (Concepto §3.5: archivar no es borrar). Se sigue pudiendo leer lo que
    // ya existe (chats viejos), pero nadie crea, modifica ni borra desde la
    // app. Los campos nuevos se cargan como activos_agro.
    // -----------------------------------------------------------------
    match /campos/{campoId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null
                || resource.data.estadoPublicacion == 'disponible'
                || parteDeActivo(resource.data)));
      allow list: if esAdmin()
        || (logueado()
            && (resource.data.estadoPublicacion == 'disponible'
                || parteDeActivo(resource.data)));

      allow create, update, delete: if esAdmin();
    }

    // -----------------------------------------------------------------
    // INVERSIONES (las ve solo quien invierte)
    // -----------------------------------------------------------------
    match /inversiones/{inversionId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null
                || resource.data.inversorId == request.auth.uid));
      allow list: if esAdmin()
        || (logueado() && resource.data.inversorId == request.auth.uid);

      allow create: if logueado()
        && request.resource.data.inversorId == request.auth.uid;

      allow update, delete: if esAdmin();
    }

    // -----------------------------------------------------------------
    // PUBLICACIONES_INVERSION
    // -----------------------------------------------------------------
    match /publicaciones_inversion/{publicacionId} {
      allow get: if esAdmin()
        || (logueado()
            && (resource == null
                || resource.data.estado == 'activa'
                || resource.data.propietarioId == request.auth.uid));
      allow list: if esAdmin()
        || (logueado()
            && (resource.data.estado == 'activa'
                || resource.data.propietarioId == request.auth.uid));

      allow create: if logueado()
        && request.resource.data.propietarioId == request.auth.uid;

      allow update: if esAdmin()
        || (logueado()
            && resource.data.propietarioId == request.auth.uid
            && !cambia(['propietarioId']));

      allow delete: if esAdmin()
        || (logueado() && resource.data.propietarioId == request.auth.uid);
    }
    // -----------------------------------------------------------------
    // TRABAJOS = TRABAJO OPERACIONAL V1
    // El trabajo pertenece al Activo Agro y hereda su autorizaciÃ³n.
    // V1: se crea y consulta; no se modifica ni elimina desde la app.
    // -----------------------------------------------------------------
    match /trabajos/{trabajoId} {
      allow get: if esAdmin()
        || (logueado()
            && (puedeActivo(resource.data.activoAgroId)
                || tieneAutorizacion(resource.data.activoAgroId, 'ver', 'trabajo')));

      allow list: if esAdmin()
        || (logueado()
            && (puedeActivo(resource.data.activoAgroId)
                || tieneAutorizacion(resource.data.activoAgroId, 'ver', 'trabajo')));

      allow create: if esAdmin()
        || (logueado()
            && (puedeActivo(request.resource.data.activoAgroId)
                || tieneAutorizacion(request.resource.data.activoAgroId, 'crear', 'trabajo')));

      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // -----------------------------------------------------------------
    // AUTORIZACIONES_ACTIVOS
    // Autorizaciones de acceso/acción sobre un Activo Agro.
    //
    // Regla v1:
    // - Solo un usuario autenticado puede otorgar.
    // - quienOtorga debe ser el usuario autenticado.
    // - quienOtorga debe ser propietario del Activo o administrador.
    // - La autorización queda vinculada al Activo.
    // - No se permite modificar identidad, origen ni alcance estructural.
    // - Las autorizaciones no se borran desde la app.
    // -----------------------------------------------------------------
    match /autorizaciones_activos/{autorizacionId} {

      allow get: if esAdmin()
        || (logueado()
            && (
              activoDe(resource.data.activoId).propietarioId
                == request.auth.uid
              || resource.data.usuarioAutorizado
                == request.auth.uid
            ));

      // AF-093 (12/11/2026): el autorizado lista SUS autorizaciones
      // (consulta por usuarioAutorizado) y el dueño las de SU campo
      // (consulta por activoId). Nadie ve las de otros.
      allow list: if esAdmin()
        || (logueado()
            && (resource.data.usuarioAutorizado == request.auth.uid
                || activoDe(resource.data.activoId).propietarioId
                     == request.auth.uid));

      allow create: if esAdmin()
        || (
          logueado()
          && request.resource.data.autorizacionId == autorizacionId
          && request.resource.data.activoId is string
          && request.resource.data.activoId != ''
          && request.resource.data.usuarioAutorizado is string
          && request.resource.data.usuarioAutorizado != ''
          && request.resource.data.quienOtorga == request.auth.uid
          && activoDe(request.resource.data.activoId).propietarioId
               == request.auth.uid
          // Nombre armado (paso 3): activoId__usuario__permiso__ambito
          // y, si tiene referencia, __referencia al final.
          && request.resource.data.permiso is string
          && request.resource.data.ambito.tipo is string
          && (
            (request.resource.data.ambito.get('referenciaId', null) == null
             && autorizacionId == request.resource.data.activoId + '__'
                  + request.resource.data.usuarioAutorizado + '__'
                  + request.resource.data.permiso + '__'
                  + request.resource.data.ambito.tipo)
            || (request.resource.data.ambito.get('referenciaId', null) is string
             && autorizacionId == request.resource.data.activoId + '__'
                  + request.resource.data.usuarioAutorizado + '__'
                  + request.resource.data.permiso + '__'
                  + request.resource.data.ambito.tipo + '__'
                  + request.resource.data.ambito.referenciaId)
          )
        );

      allow update: if esAdmin()
        || (
          logueado()
          && resource.data.quienOtorga == request.auth.uid
          && resource.data.activoId == request.resource.data.activoId
          && resource.data.usuarioAutorizado
               == request.resource.data.usuarioAutorizado
          && resource.data.autorizacionId
               == request.resource.data.autorizacionId
          // El nombre depende del permiso y el ambito: no se cambian.
          && resource.data.permiso == request.resource.data.permiso
          && resource.data.ambito == request.resource.data.ambito
        );

      allow delete: if false;
    }
    // -----------------------------------------------------------------
    // INTERVENCIONES PROFESIONALES (AF-093, GAP-PROF-01, 12/11/2026)
    // El profesional invitado (autorizacion ACTIVA "crear" en el ambito
    // "expedienteProductivo") registra visitas, recomendaciones, etc.
    // NO lee el expediente: solo carga lo suyo. Las ven el dueno (o quien
    // cargo el expediente) y quien las cargo. Son de SOLO AGREGAR.
    // El titulo profesional queda "declarado" hasta que se verifique.
    // -----------------------------------------------------------------
    function tiposIntervencion() {
      return ['visita', 'recomendacion', 'diagnostico', 'informe', 'otro'];
    }

    match /intervenciones_profesionales/{intervencionId} {
      allow get, list: if esAdmin()
        || (logueado()
            && (resource.data.profesionalId == request.auth.uid
                || puedeActivo(resource.data.activoAgroId)));

      allow create: if logueado()
        && request.resource.data.intervencionId == intervencionId
        && request.resource.data.profesionalId == request.auth.uid
        && request.resource.data.activoAgroId is string
        && request.resource.data.tipo in tiposIntervencion()
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() > 0
        && request.resource.data.estado == 'declarado'
        && (puedeActivo(request.resource.data.activoAgroId)
            || tieneAutorizacion(request.resource.data.activoAgroId,
                 'crear', 'expedienteProductivo'));

      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // MOVIMIENTOS = TRASLADOS (AF-089, GAP-MOV-01, 12/11/2026)
    // Nucleo comun de transporte: UNA coleccion para todas las actividades
    // (campo "actividad"). Lo ven y cargan el dueno o quien tenga una
    // autorizacion en "movimientos" (el broker no). No se borra. Solo
    // cambia el estado y lo recibido, y solo mientras no termino.
    // -----------------------------------------------------------------
    function puedeMovimientos(activoId, permiso) {
      return esAdmin()
        || (logueado()
            && activoId is string
            && (esDuenoActivo(activoId)
                || tieneAutorizacion(activoId, permiso, 'movimientos')));
    }

    function actividadesMovimiento() {
      return ['ganaderia', 'agricultura', 'apicultura', 'piscicultura', 'otra'];
    }

    function estadosMovimiento() {
      return ['programado', 'enCamino', 'entregado', 'cancelado'];
    }

    match /movimientos/{movimientoId} {
      allow get, list: if puedeMovimientos(resource.data.activoAgroId, 'ver');

      allow create: if puedeMovimientos(request.resource.data.activoAgroId, 'crear')
        && request.resource.data.movimientoId == movimientoId
        && request.resource.data.cargadoPor == request.auth.uid
        && request.resource.data.actividad in actividadesMovimiento()
        && request.resource.data.estado in ['programado', 'enCamino']
        && request.resource.data.cantidadDeclarada is number
        && request.resource.data.cantidadDeclarada > 0
        && request.resource.data.unidad is string
        && request.resource.data.carga is string
        && request.resource.data.carga.size() > 0
        && request.resource.data.destinoDescripcion is string
        && request.resource.data.destinoDescripcion.size() > 0
        && request.resource.data.estadoDato == 'declarado';

      allow update: if puedeMovimientos(resource.data.activoAgroId, 'modificar')
        && resource.data.estado in ['programado', 'enCamino']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'cantidadRecibida', 'fechaEntrega',
                      'actualizadoPor', 'fechaActualizacion'])
        && request.resource.data.estado in estadosMovimiento()
        && request.resource.data.actualizadoPor == request.auth.uid
        && (request.resource.data.get('cantidadRecibida', null) == null
            || (request.resource.data.cantidadRecibida is number
                && request.resource.data.cantidadRecibida >= 0));

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // PRODUCCION (paso 6a, GAP-PROD-01, 10/11/2026)
    // Tres colecciones colgadas del Activo (activoAgroId):
    //   unidades_productivas = donde (potrero, corral, galpon...)
    //   grupos_productivos   = que (rodeo o lote de animales)
    //   eventos_productivos  = que paso (alta, baja, movimiento...)
    // Las ve y carga el dueno (o quien cargo el expediente) o quien tenga
    // una autorizacion en el ambito "produccion".
    // Unidades y grupos no se borran: se archivan o se cierran.
    // Los eventos son de SOLO AGREGAR: no se editan ni se borran.
    // -----------------------------------------------------------------
    function puedeProduccion(activoId, permiso) {
      return esAdmin()
        || (logueado()
            && (puedeActivo(activoId)
                || tieneAutorizacion(activoId, permiso, 'produccion')));
    }

    function tiposEventoProductivo() {
      return ['alta', 'baja', 'movimiento', 'cambioCategoria', 'sanidad',
              'reproduccion', 'pesaje', 'alimentacion', 'siembra', 'cosecha',
              'monitoreo', 'aplicacion'];
    }

    match /unidades_productivas/{unidadId} {
      allow get, list: if puedeProduccion(resource.data.activoAgroId, 'ver');

      allow create: if puedeProduccion(request.resource.data.activoAgroId, 'crear')
        && request.resource.data.unidadId == unidadId
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'activa';

      // Se corrige el nombre o los datos, o se archiva. Nunca cambia de
      // Activo ni de autor.
      allow update: if puedeProduccion(resource.data.activoAgroId, 'modificar')
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nombre', 'superficieHa', 'capacidad',
                      'infraestructuraId', 'estado', 'observaciones'])
        && request.resource.data.estado in ['activa', 'archivada'];

      allow delete: if false;
    }

    match /grupos_productivos/{grupoId} {
      allow get, list: if puedeProduccion(resource.data.activoAgroId, 'ver');

      allow create: if puedeProduccion(request.resource.data.activoAgroId, 'crear')
        && request.resource.data.grupoId == grupoId
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'activo';

      // Solo se corrige el nombre o se cierra. La etapa y la tenencia
      // cambian con un evento, para que quede la historia.
      allow update: if puedeProduccion(resource.data.activoAgroId, 'modificar')
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nombre', 'estado', 'observaciones'])
        && request.resource.data.estado in ['activo', 'cerrado'];

      allow delete: if false;
    }

    match /eventos_productivos/{eventoId} {
      allow get, list: if puedeProduccion(resource.data.activoAgroId, 'ver');

      allow create: if puedeProduccion(request.resource.data.activoAgroId, 'crear')
        && request.resource.data.eventoId == eventoId
        && request.resource.data.cargadoPor == request.auth.uid
        && request.resource.data.tipo in tiposEventoProductivo()
        // El grupo tiene que ser del mismo Activo.
        && get(/databases/$(database)/documents/grupos_productivos/$(request.resource.data.grupoId)).data.activoAgroId
             == request.resource.data.activoAgroId
        // Si dice una cantidad, tiene que ser un entero mayor a cero.
        && (request.resource.data.get('cantidad', null) == null
            || (request.resource.data.cantidad is int
                && request.resource.data.cantidad > 0))
        // GAP-AGRO-01: hectareas mayores a cero, lo cosechado no negativo,
        // unidad conocida y humedad entre 0 y 100 (si vienen).
        && (request.resource.data.get('superficieHa', null) == null
            || (request.resource.data.superficieHa is number
                && request.resource.data.superficieHa > 0))
        && (request.resource.data.get('cantidadObtenida', null) == null
            || (request.resource.data.cantidadObtenida is number
                && request.resource.data.cantidadObtenida >= 0))
        && (request.resource.data.get('unidadMedida', null) == null
            || request.resource.data.unidadMedida in ['tn', 'kg', 'qq'])
        && (request.resource.data.get('humedad', null) == null
            || (request.resource.data.humedad is number
                && request.resource.data.humedad >= 0
                && request.resource.data.humedad <= 100))
        // GAP-MON-01: el monitoreo dice que se miro, el nivel y de donde
        // sale el dato, siempre de la lista (nada inventado).
        && (request.resource.data.get('objetivoMonitoreo', null) == null
            || request.resource.data.objetivoMonitoreo in
                ['plaga', 'maleza', 'enfermedad', 'estadoCultivo', 'agua', 'otro'])
        && (request.resource.data.get('nivel', null) == null
            || request.resource.data.nivel in ['bajo', 'medio', 'alto'])
        && (request.resource.data.get('fuenteDato', null) == null
            || request.resource.data.fuenteDato in
                ['recorrida', 'dron', 'satelite', 'sensor', 'estacion',
                 'laboratorio', 'otro'])
        && (request.resource.data.tipo != 'monitoreo'
            || (request.resource.data.get('objetivoMonitoreo', null) != null
                && request.resource.data.get('nivel', null) != null
                && request.resource.data.get('fuenteDato', null) != null))
        // GAP-APLI-01: la aplicacion dice hectareas, producto y dosis;
        // viento no negativo, temperatura razonable y humedad del aire
        // entre 0 y 100 (si vienen).
        && (request.resource.data.get('vientoKmh', null) == null
            || (request.resource.data.vientoKmh is number
                && request.resource.data.vientoKmh >= 0))
        && (request.resource.data.get('temperatura', null) == null
            || (request.resource.data.temperatura is number
                && request.resource.data.temperatura >= -30
                && request.resource.data.temperatura <= 60))
        && (request.resource.data.get('humedadAmbiente', null) == null
            || (request.resource.data.humedadAmbiente is number
                && request.resource.data.humedadAmbiente >= 0
                && request.resource.data.humedadAmbiente <= 100))
        && (request.resource.data.tipo != 'aplicacion'
            || (request.resource.data.get('superficieHa', null) != null
                && request.resource.data.get('tratamiento', null) is string
                && request.resource.data.tratamiento.size() > 0
                && request.resource.data.get('dosis', null) is string
                && request.resource.data.dosis.size() > 0));

      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // OPERACIONES PROTEGIDAS (paso 7a, GAP-OPER-01, 10/11/2026)
    // Concepto General Integral 6.2: proteger al productor ANTES de
    // entregar hacienda, granos u otros productos.
    //   operaciones_protegidas = la ficha del negocio (comprador, importe,
    //                            forma de pago, garantias)
    //   eventos_operacion      = que paso (cheque acordado, entrega,
    //                            cobro, rechazo, incumplimiento, nota)
    // Son datos de plata: las ve y carga SOLO el dueno del Activo (no
    // quien cargo el expediente) o quien tenga una autorizacion en el
    // ambito "operaciones".
    // La operacion se corrige mientras esta en curso; cerrada, queda fija.
    // Nunca se borra. Los eventos son de SOLO AGREGAR.
    // Agro Fields no garantiza el pago: organiza y avisa.
    // -----------------------------------------------------------------
    function puedeOperaciones(activoId, permiso) {
      return esAdmin()
        || (logueado()
            && activoId is string
            && (esDuenoActivo(activoId)
                || tieneAutorizacion(activoId, permiso, 'operaciones')));
    }

    function productosOperacion() {
      return ['hacienda', 'granos', 'otro'];
    }

    function formasPagoOperacion() {
      return ['contado', 'transferencia', 'cheque', 'echeq', 'mixto', 'otro'];
    }

    function estadosOperacion() {
      return ['enCurso', 'cumplida', 'conIncumplimiento', 'cancelada'];
    }

    function tiposEventoOperacion() {
      return ['pagoAcordado', 'entrega', 'cobro', 'rechazo',
              'incumplimiento', 'nota'];
    }

    // Lo que tiene que cumplir una operacion al guardarse.
    function operacionValida(d) {
      return d.producto in productosOperacion()
        && d.formaPago in formasPagoOperacion()
        && d.importe is number
        && d.importe > 0;
    }

    match /operaciones_protegidas/{operacionId} {
      allow get, list: if puedeOperaciones(resource.data.activoAgroId, 'ver');

      allow create: if puedeOperaciones(request.resource.data.activoAgroId, 'crear')
        && request.resource.data.operacionId == operacionId
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'enCurso'
        && operacionValida(request.resource.data);

      // Solo mientras esta en curso. Nunca cambia de Activo, de autor ni
      // de fecha de creacion.
      allow update: if puedeOperaciones(resource.data.activoAgroId, 'modificar')
        && resource.data.estado == 'enCurso'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['producto', 'descripcionProducto', 'cantidad', 'unidad',
                      'grupoId', 'importe', 'moneda', 'formaPago', 'comprador',
                      'garantias', 'contratoArchivoRuta', 'estado',
                      'fechaCierre', 'observaciones'])
        && request.resource.data.estado in estadosOperacion()
        && operacionValida(request.resource.data);

      allow delete: if false;
    }

    match /eventos_operacion/{eventoId} {
      allow get, list: if puedeOperaciones(resource.data.activoAgroId, 'ver');

      allow create: if puedeOperaciones(request.resource.data.activoAgroId, 'crear')
        && request.resource.data.eventoId == eventoId
        && request.resource.data.cargadoPor == request.auth.uid
        && request.resource.data.tipo in tiposEventoOperacion()
        && request.resource.data.operacionId is string
        // La operacion tiene que ser del mismo Activo y no estar cancelada.
        && get(/databases/$(database)/documents/operaciones_protegidas/$(request.resource.data.operacionId)).data.activoAgroId
             == request.resource.data.activoAgroId
        && get(/databases/$(database)/documents/operaciones_protegidas/$(request.resource.data.operacionId)).data.estado
             != 'cancelada'
        // Importe y cantidad, si estan, mayores a cero.
        && (request.resource.data.get('importe', null) == null
            || (request.resource.data.importe is number
                && request.resource.data.importe > 0))
        && (request.resource.data.get('cantidad', null) == null
            || (request.resource.data.cantidad is number
                && request.resource.data.cantidad > 0));

      allow update, delete: if false;
    }

    // TODO LO DEMAS: PROHIBIDO
    // -----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


