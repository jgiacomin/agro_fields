rules_version = '2';

// =====================================================================
// AGRO FIELDS V8 - STORAGE RULES (BORRADOR PARA PROBAR EN EMULADOR)
//
// Estructura de carpetas:
//   activos/{activoId}/privado/...   -> documentos y evidencias del expediente
//                                       (solo dueño o quien lo cargó)
//   activos/{activoId}/privado/documentos/{documentoId}/{archivo}
//                                    -> además, quien tenga autorización en el
//                                       ámbito "documentacion" (paso 4b)
//   activos/{activoId}/publico/...   -> fotos del resumen público
//                                       (las ve cualquier usuario logueado)
//   usuarios/{uid}/...               -> foto de perfil
//
// Todo lo demás está prohibido.
// Los archivos no se borran desde la app (trazabilidad): solo administrador.
// =====================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function adminUids() {
      return ['RtUPcWdZHuQMNsDrza7firR2X2j1'];
    }

    function logueado() {
      return request.auth != null;
    }

    function esAdmin() {
      return logueado()
        && (request.auth.uid in adminUids()
            || request.auth.token.get('admin', false) == true);
    }

    // Lee el expediente en Firestore para saber quién es el dueño.
    function activoDe(id) {
      return firestore.get(
        /databases/(default)/documents/activos_agro/$(id)
      ).data;
    }

    function esDuenoActivo(id) {
      return logueado() && activoDe(id).propietarioId == request.auth.uid;
    }

    function puedeActivo(id) {
      return logueado()
        && (activoDe(id).propietarioId == request.auth.uid
            || activoDe(id).get('publicadorId', '') == request.auth.uid);
    }

    // Autorización del paso 3 (nombre armado activoId__usuario__permiso__ambito).
    // Ojo: las Storage Rules consultan como máximo 2 documentos de
    // Firestore por pedido: el Activo y esta autorización. No agregar más.
    function rutaAutorizacion(activoId, permiso, ambito) {
      return /databases/(default)/documents/autorizaciones_activos/$(activoId + '__' + request.auth.uid + '__' + permiso + '__' + ambito);
    }

    function tieneAutorizacion(activoId, permiso, ambito) {
      return logueado()
        && firestore.exists(rutaAutorizacion(activoId, permiso, ambito))
        && firestore.get(rutaAutorizacion(activoId, permiso, ambito)).data.estado == 'activa'
        && firestore.get(rutaAutorizacion(activoId, permiso, ambito)).data.activoId == activoId
        && firestore.get(rutaAutorizacion(activoId, permiso, ambito)).data.usuarioAutorizado == request.auth.uid
        && firestore.get(rutaAutorizacion(activoId, permiso, ambito)).data.fechaInicio <= request.time
        && (firestore.get(rutaAutorizacion(activoId, permiso, ambito)).data.get('fechaFin', null) == null
            || firestore.get(rutaAutorizacion(activoId, permiso, ambito)).data.fechaFin > request.time)
        && firestore.get(rutaAutorizacion(activoId, permiso, ambito)).data.ambito.get('referenciaId', null) == null;
    }

    // Límites de subida.
    function esImagen() {
      return request.resource.contentType.matches('image/.*');
    }
    function esDocumento() {
      return request.resource.contentType.matches('image/.*|application/pdf');
    }
    function pesaMenosDe(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ---------------- EXPEDIENTE PRIVADO ----------------
    match /activos/{activoId}/privado/{archivo=**} {
      allow read: if esAdmin() || puedeActivo(activoId);

      // resource == null: solo si el archivo todavía no existe. Subir con el
      // mismo nombre de uno existente cuenta como "crear" y lo pisaría.
      allow create: if (esAdmin() || puedeActivo(activoId))
        && resource == null
        && esDocumento() && pesaMenosDe(20);

      // Un archivo ya subido no se reemplaza ni se borra desde la app.
      allow update, delete: if esAdmin();
    }

    // ---------------- DOCUMENTOS DEL EXPEDIENTE (paso 4b) ----------------
    // El dueño ya entra por la regla de arriba (privado). Acá se suma quien
    // tenga autorización: "ver" para leer y "crear" para subir, en el
    // ámbito "documentacion". Nadie reemplaza ni borra desde la app.
    match /activos/{activoId}/privado/documentos/{documentoId}/{archivo} {
      allow read: if tieneAutorizacion(activoId, 'ver', 'documentacion');

      allow create: if tieneAutorizacion(activoId, 'crear', 'documentacion')
        && resource == null
        && esDocumento() && pesaMenosDe(20);
    }

    // ---------------- RESUMEN PUBLICO ----------------
    match /activos/{activoId}/publico/{archivo=**} {
      allow read: if logueado();

      allow create: if (esAdmin() || esDuenoActivo(activoId))
        && esImagen() && pesaMenosDe(10);

      allow update, delete: if esAdmin() || esDuenoActivo(activoId);
    }

    // ---------------- FOTO DE PERFIL ----------------
    match /usuarios/{uid}/{archivo=**} {
      allow read: if logueado();

      allow write: if logueado()
        && request.auth.uid == uid
        && esImagen() && pesaMenosDe(5);
    }

    // ---------------- OPERACIONES PROTEGIDAS (paso 7a) ----------------
    // Foto del cheque, contrato, poder del firmante. Son datos de plata:
    // solo el dueño o quien tenga autorización en el ámbito "operaciones".
    // Quien cargó el expediente (broker) NO entra, igual que en Firestore.
    // Consulta 2 documentos de Firestore como máximo (Activo y autorización).
    // Nadie reemplaza ni borra desde la app.
    match /activos/{activoId}/operaciones/{operacionId}/{archivo} {
      allow read: if esAdmin()
        || esDuenoActivo(activoId)
        || tieneAutorizacion(activoId, 'ver', 'operaciones');

      allow create: if (esAdmin()
          || esDuenoActivo(activoId)
          || tieneAutorizacion(activoId, 'crear', 'operaciones'))
        && resource == null
        && esDocumento() && pesaMenosDe(20);

      allow update, delete: if esAdmin();
    }

    // ---------------- TODO LO DEMAS: PROHIBIDO ----------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
